{
  "expo": {
    "name": "π Game",
    "slug": "pi-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegoortiz.pigame",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.diegoortiz.pigame",
      "versionCode": 1,
      "permissions": [
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0A1628"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "211d8e91-4667-4f15-ab13-c59a704446f9"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-localization"
    ],
    "backgroundColor": "#0A1628"
  }
}
